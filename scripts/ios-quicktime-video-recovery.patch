+enum class VideoSilenceAction { None, RequestFrame, ReopenStream };
+
+constexpr VideoSilenceAction video_silence_action(
+    bool received_video, std::chrono::milliseconds video_silence,
+    std::chrono::milliseconds media_silence) noexcept {
+    constexpr auto Trigger = std::chrono::milliseconds(2500);
+    if (!received_video || video_silence < Trigger) return VideoSilenceAction::None;
+    return media_silence < Trigger ? VideoSilenceAction::RequestFrame :
+        VideoSilenceAction::ReopenStream;
+}
 
