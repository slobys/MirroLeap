{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Device administration and file dialogs limited to the main UI; no shell plugin execution.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    "clipboard-manager:allow-write-image",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-relaunch"
  ]
}
