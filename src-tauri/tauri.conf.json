{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirroLeap",
  "version": "5.0.3",
  "identifier": "com.kb.scrcpy-gui-v3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MirroLeap",
        "width": 940,
        "height": 680,
        "visible": false,
        "resizable": true,
        "center": true,
        "transparent": false,
        "decorations": true,
        "minWidth": 740,
        "minHeight": 550
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 500,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "slobys (community build)",
    "copyright": "Copyright © 2026 slobys and MirroLeap contributors. Based on scrcpy-gui.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDOEY2MTdBQzJGQUY2RTMKUldUajl2ckNlbUdQdktIUXNTQjFyRS9DVkVJOWYwNUFxbktvaUNPNTF4OGtyaHVtSzFVbHBZMEQK",
      "endpoints": [
        "https://github.com/slobys/MirroLeap/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
